# 数据库
DATABASE_URL="postgresql://<用户名>@localhost:5432/lvtu?schema=public"

# JWT
JWT_SECRET="请替换为随机字符串"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# DeepSeek(https://platform.deepseek.com → API keys;留空则 AI 走 Mock 演示模式)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 高德 Web 服务 API key(https://lbs.amap.com 控制台,服务平台选「Web服务」;留空则 /geo/* 返回 503)
AMAP_KEY=""

PORT=3000
